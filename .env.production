## ============================
## API URLs (must start with NEXT_PUBLIC_ to be available client-side)
## ============================
NEXT_PUBLIC_API_URL=https://africafunds.chainsolutions.fr
NEXT_PUBLIC_SITE_URL=https://africafunds.chainsolutions.fr
NEXT_PUBLIC_API_IMAGE_URL=https://africafunds.chainsolutions.fr/uploads
NEXT_PUBLIC_PYTHON_API_URL=https://africafunds.chainsolutions.fr/python
NEXT_PUBLIC_STABLECOIN_API_URL=https://api.stablecoin.chainsolutions.fr
NEXT_PUBLIC_STABLECOIN_API_KEY=CHANGER_CLE_STABLECOIN
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=CHANGER_CLE_MAGIC

## ============================
## NextAuth (OAuth)
## ============================
NEXTAUTH_URL=https://africafunds.chainsolutions.fr
## Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGER_GENERER_NOUVEAU_SECRET

## ============================
## Google OAuth (https://console.cloud.google.com/apis/credentials)
## ============================
GOOGLE_CLIENT_ID=CHANGER_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGER_GOOGLE_CLIENT_SECRET
